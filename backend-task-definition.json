{
  "family": "atenea-backend-task",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::586794473929:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "atenea-backend-container",
      "image": "<ECR_URI>:<IMAGE_TAG>",
      "portMappings": [
        {
          "containerPort": 3001,
          "hostPort": 3001,
          "protocol": "tcp"
        }
      ],
      "essential": true
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512"
}

