{
  "family": "ateneaback-task",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "ateneaback",
      "image": "<ECR_URI>:<IMAGE_TAG>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3001,
          "hostPort": 3001,
          "protocol": "tcp"
        }
      ]
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512"
}

